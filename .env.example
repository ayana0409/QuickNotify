# ==============================================================================
# QuickNotify – Configuration Template
# Copy to .env and fill in your values: cp .env.example .env
# This file IS committed to Git. The actual .env is gitignored.
# ==============================================================================

# ── HTTP Server ────────────────────────────────────────────────────────────────
SERVER_HTTP_PORT=8080
SERVER_READ_TIMEOUT_SEC=15
SERVER_WRITE_TIMEOUT_SEC=15
# Comma-separated list of allowed CORS origins for WebSocket handshake
SERVER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://*.yourdomain.com
# Optional subpath prefix when deploying behind a reverse proxy (e.g. /quick-notify)
SERVER_BASE_PATH=

# ── Client Authentication (WebSocket JWT) ─────────────────────────────────────
AUTH_JWT_SECRET=change_me_in_production

# ── Admin Dashboard ────────────────────────────────────────────────────────────
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
ADMIN_JWT_SECRET=change_me_in_production

# ── Kafka – QuickNotify's own core cluster ─────────────────────────────────────
# Comma-separated brokers of QuickNotify's primary Kafka cluster
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP=quicknotify-core-group
# Standard envelope topic (uses DirectTranslator; for ShorterLink and any service
# that publishes the NotificationEnvelope format directly)
KAFKA_STANDARD_TOPIC=global-notify-events

# ── Kafka – Multi-cluster mapping for external/legacy projects ─────────────────
# Kafka 1 has topics 1.1, 1.2 → Kafka 2 has topics 2.1, 2.2, etc.
# Define as JSON strings so a single .env file covers all clusters and topics.
#
# KAFKA_CLUSTERS – array of independent Kafka clusters, one entry per cluster:
# KAFKA_CLUSTERS=[{"id":"cluster_id","brokers":["host:port",...]}]
#
# KAFKA_CONSUMERS – array of topic→cluster→translator mappings:
# KAFKA_CONSUMERS=[{"topic":"topic-name","cluster_id":"cluster_id","translator":"translator_name"}]
#
# Available built-in translators: direct | quickbite_order | edutrack_exam
#
# Example (uncomment and edit):
# KAFKA_CLUSTERS='[{"id":"cluster_quickbite","brokers":["kafka.quickbite.local:9092"]},{"id":"cluster_edutrack","brokers":["10.0.2.15:9092","10.0.2.16:9092"]}]'
# KAFKA_CONSUMERS='[{"topic":"order-events","cluster_id":"cluster_quickbite","translator":"quickbite_order"},{"topic":"edutrack-exam-results","cluster_id":"cluster_edutrack","translator":"edutrack_exam"}]'

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@quicknotify.example.com

# ── Logging ────────────────────────────────────────────────────────────────────
# Levels: debug | info | warn | error
LOG_LEVEL=info
LOG_DEVELOPMENT=false

